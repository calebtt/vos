<?xml version="1.0" encoding="utf-8"?>
<!-- S-07 probe: can a microphone FGS start from a summon (assistant session show, QS tile)?
     No launcher activity, no INTERNET, no audio output. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:allowBackup="false"
        android:label="VOS S07 probe">

        <!-- Makes the app qualify for android.app.role.ASSISTANT. -->
        <service
            android:name=".ProbeVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".ProbeSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Stub required by voice-interaction-service XML; never opens the mic. -->
        <service
            android:name=".ProbeRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <service
            android:name=".ProbeTile"
            android:exported="true"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:label="VOS S07"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".MicFgs"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
