<?xml version="1.0" encoding="utf-8"?>
<!-- Actuator: trusted base, sensors and hands, NO INTERNET (§3.1, §5.2). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only the session (same signer) may bind ActuatorService (§5.3). -->
    <permission
        android:name="com.vos.permission.SESSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="com.vos.permission.ACTUATOR" />
    <!-- Voice turns (§3.2, §3.3): the microphone foreground service, its notification, and the
         communication mode and device. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- The assistant-role check after boot (decision 45). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Defense in depth: strip INTERNET even if a library asks for it. ci/policy_check.py checks the APK. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Package visibility for the Binder guard and the peer binding (§5.3), and the default home app
         (shell_nav's oracle: "home" is verified when that app is in front). -->
    <queries>
        <package android:name="com.vos.session" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- app_open: the apps with a launcher entry, by name. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ActuatorApp"
        android:allowBackup="false"
        android:label="@string/app_name">

        <service
            android:name=".ActuatorService"
            android:exported="true"
            android:permission="com.vos.permission.SESSION" />

        <!-- The open voice turn (§3.2). Started only by actuator components with a foreground moment. -->
        <service
            android:name=".TurnService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Summon / stop (M1-STOP-01). Only the system (BIND_QUICK_SETTINGS_TILE) can bind it;
             ci/policy_check.py enforces the guard. -->
        <service
            android:name=".SummonTile"
            android:exported="true"
            android:icon="@drawable/ic_vos"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Hands (§3.1): exported so the system can bind it; only holders of the system-only
             BIND_* permission (i.e. system_server) can. ci/policy_check.py enforces the guard. -->
        <service
            android:name=".HandsService"
            android:exported="true"
            android:label="@string/hands_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/hands_service" />
        </service>

        <!-- The assistant role (decision 45, §3.1): only the system (BIND_VOICE_INTERACTION) binds
             these. ci/policy_check.py enforces the guard. -->
        <service
            android:name=".VosAssistService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/vos_assistant" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".VosAssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Required by the voice-interaction-service XML; refuses every request, never opens the mic. -->
        <service
            android:name=".VosRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <!-- Typed chat (decision 21, row 25): the actuator-owned window, and the chat notification's
             direct reply, which only the actuator's own PendingIntent reaches (not exported). -->
        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:label="@string/chat_label"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ChatNotification$Reply"
            android:exported="false" />

        <!-- The open typed turn, as a short foreground service: no microphone. It keeps the session,
             which the actuator binds for the turn, out of Android's background network block. -->
        <service
            android:name=".TypedTurnService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- The typed turn notification's Stop (P5); only that notification's PendingIntent reaches it. -->
        <receiver
            android:name=".TypedTurnService$Stop"
            android:exported="false" />

        <receiver
            android:name=".BootCheck"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".NotificationsService"
            android:exported="true"
            android:label="@string/notifications_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
